{
  "name": "astro-theme-autuswing",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Autuswing for Astro — a responsive static blog theme inspired by Yelee.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiSenn/astro-theme-autuswing.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "build": "astro build",
    "postbuild": "node scripts/verify-dist-links.mjs",
    "verify:dist": "node scripts/verify-dist-links.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "tsx scripts/check-content.ts --output && tsx scripts/verify-output.ts",
    "new-post": "node scripts/new-post.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "dev:drafts": "node scripts/dev-drafts.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "css-tree": "3.2.1",
    "entities": "8.1.0",
    "js-yaml": "5.5.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "cheerio": "1.2.0",
    "katex": "0.19.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
