{
  "name": "astro-theme-autuswing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Autuswing for Astro — a responsive static blog theme inspired by Yelee.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiSenn/astro-theme-autuswing.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "build": "astro build",
    "preview": "node scripts/preview.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "node scripts/verify-content.mjs && tsx scripts/verify-output.ts",
    "test:browser": "playwright test",
    "test:styles": "playwright test --config playwright.styles.config.ts",
    "verify:styles": "node scripts/check-styles.mjs",
    "test:browser:cross": "playwright test --config playwright.cross.config.ts",
    "test:nginx": "playwright test --config playwright.nginx.config.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "prepare:nginx": "node scripts/prepare-nginx.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "new-post": "node scripts/new-post.mjs",
    "legacy:approve": "node scripts/approve-legacy-revision.mjs",
    "test:legacy-revisions": "node scripts/verify-legacy-revision-fixtures.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "publish:check": "node scripts/release.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "release:build": "node scripts/release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:release": "node scripts/verify-release-fixtures.mjs",
    "dev:drafts": "node scripts/dev-drafts.mjs",
    "test:markdown": "playwright test tests/browser/markdown-reading.spec.ts",
    "verify:writing": "node scripts/verify-writing.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "entities": "8.1.0",
    "js-yaml": "5.5.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "cheerio": "1.2.0",
    "katex": "0.19.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
