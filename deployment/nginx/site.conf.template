# Standalone preview server. Keep production site/SSL configuration separate.
server {
    listen @@LISTEN@@;
    server_name localhost;
    root "@@ROOT@@";
    index index.html;
    absolute_redirect off;
    charset utf-8;
    autoindex off;

    # One header definition, with location-specific values: no duplicate
    # Cache-Control and no loss of inherited security/preview headers.
    set $autuswing_cache "public, max-age=0, must-revalidate";
    set $autuswing_cors "";
    add_header Cache-Control $autuswing_cache always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Access-Control-Allow-Origin $autuswing_cors;
    @@ROBOTS@@

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json application/xml image/svg+xml;

    include "@@REDIRECTS@@";
    error_page 404 /404.html;
    location = /404.html {
        internal;
        set $autuswing_cache "no-store";
    }
    location = /sw.js {
        set $autuswing_cache "no-cache";
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        set $autuswing_cache "no-cache";
        default_type application/manifest+json;
        try_files $uri =404;
    }
    location = /_headers { return 404; }
    location = /_redirects { return 404; }
    location = /redirects.json { return 404; }
    location ^~ /_astro/ {
        set $autuswing_cache "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location ~ "^/pwa/(icon-(192|512)|maskable-512)\.[a-f0-9]{16}\.webp$" {
        set $autuswing_cache "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location ~ ^/assets/vendor/(katex|mathjax|newcm)/[0-9][^/]+/ {
        set $autuswing_cache "public, max-age=31536000, immutable";
        set $autuswing_cors "*";
        try_files $uri =404;
    }
    location ^~ /img/ {
        set $autuswing_cache "public, max-age=86400";
        try_files $uri =404;
    }
    location / {
        # Preserve explicit .html permalinks and real HTTP 404 responses.
        try_files $uri $uri/ =404;
    }
}
