---
import { mountPath, mountReference } from '../lib/deployment.mjs';
import { translate } from '../lib/i18n';
const t = translate();
import BaseLayout from './BaseLayout.astro';
import { posts, type Post, isIndexable, seriesGroup } from '../lib/content';
import { absolute } from '../lib/urls';
import { formatDate } from '../lib/dates';
import { cardUpdated } from '../lib/card-updated';
import { theme } from '../site.config';
import Comments from '../components/Comments.astro';
import SurfaceWallpaper from '../components/SurfaceWallpaper.astro';
import CopyrightNotice from '../components/CopyrightNotice.astro';
import Glyph from '../components/Glyph.astro';
import { localImageDimensions } from '../lib/markdown-features.mjs';
interface Props {
  post: Post;
}
const { post } = Astro.props,
  all = await posts(),
  index = all.findIndex((p) => p.path === post.path),
  previous = all[index - 1],
  next = all[index + 1];
const Content = post.rendered.Content;
const coverSize =
  post.data.cover ? await localImageDimensions(post.data.cover) : undefined;
const showUpdated = theme.article.updated && post.updated !== post.date;
const mobileUpdated = theme.article.updated ? cardUpdated(post.data) : undefined;
// 文末版权已有更新时间；关闭版权模块时仍保留这项文章信息。
const showMobileUpdated = showUpdated && !theme.copyright.enable;
const hasTaxonomy = post.categoryItems.length > 0 || post.tags.length > 0;
const networks: Record<string, string> = {
  weibo: `https://service.weibo.com/share/share.php?url=${encodeURIComponent(absolute(post.path))}&title=${encodeURIComponent(post.title)}`,
  twitter: `https://twitter.com/intent/tweet?url=${encodeURIComponent(absolute(post.path))}&text=${encodeURIComponent(post.title)}`,
  telegram: `https://t.me/share/url?url=${encodeURIComponent(absolute(post.path))}&text=${encodeURIComponent(post.title)}`,
  qq: `https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(absolute(post.path))}&title=${encodeURIComponent(post.title)}`,
};
const related = theme.reading.related
  ? all
      .filter(
        (p) =>
          p !== post &&
          isIndexable(p) &&
          (!theme.article.post_nav || ![previous?.path, next?.path].includes(p.path)),
      )
      .map((p) => ({ p, score: p.tags.filter((t) => post.tags.includes(t)).length }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
  : [];
const series = seriesGroup(all, post);
---

<BaseLayout path={post.path} title={post.title} post={post}>
  <div class="article-layout">
    <article
      class:list={[
        'article',
        { 'mica-card mica-article': theme.cards.enable && theme.cards.article },
      ]}
    >
      <SurfaceWallpaper wallpaper={post.data.wallpaper} />
      <header class="article-header">
        <h1>{post.title}</h1>
        <div class="post-meta">
          <time datetime={post.date}>{post.dateLabel}</time>
          {theme.article.reading_time && (
            <span>
              {' '}
              {post.minutes} {t('minutes')}
            </span>
          )}
          {theme.article.word_count && (
            <span class="article-meta-secondary">
              {' '}
              {post.words} {t('words')}
            </span>
          )}
          {showUpdated && (
            <span class="article-meta-secondary">
              {' '}
              {t('updated')} <time datetime={post.updated}>{formatDate(post.updated)}</time>
            </span>
          )}
          {mobileUpdated && (
            <span class="article-meta-mobile-updated">
              {t('updated')}{' '}
              <time datetime={mobileUpdated.datetime}>
                {mobileUpdated.label.replaceAll('-', '.')}
              </time>
            </span>
          )}
        </div>
        <div class="card-tags">
          {post.categoryItems.map((c) => (
            <a class="category-label" href={mountPath(c.path)}>
              {c.name}
            </a>
          ))}
          {post.tags.map((t) => (
            <a href={mountPath(`/tags/${t}/`)}>#{t}</a>
          ))}
        </div>
      </header>
      {post.data.cover && (
        <img
          class="post-cover"
          src={mountReference(post.data.cover)}
          width={coverSize?.width}
          height={coverSize?.height}
          alt={post.title}
          decoding="async"
          fetchpriority="high"
        />
      )}
      <div class="prose">
        <Content />
      </div>
      {(theme.article.word_count || showMobileUpdated || hasTaxonomy) && (
        <div class="article-mobile-details">
          {(theme.article.word_count || showMobileUpdated) && (
            <div class="post-meta">
              {theme.article.word_count && (
                <span>
                  {post.words} {t('words')}
                </span>
              )}
              {showMobileUpdated && (
                <span>
                  {t('updated')} <time datetime={post.updated}>{formatDate(post.updated)}</time>
                </span>
              )}
            </div>
          )}
          {hasTaxonomy && (
            <div class="card-tags">
              {post.categoryItems.map((c) => (
                <a class="category-label" href={mountPath(c.path)}>
                  {c.name}
                </a>
              ))}
              {post.tags.map((tag) => (
                <a href={mountPath(`/tags/${tag}/`)}>#{tag}</a>
              ))}
            </div>
          )}
        </div>
      )}
      <CopyrightNotice post={post} />
      {theme.article.share.length > 0 && (
        <div class="article-actions" aria-label={t('share')}>
          {theme.article.share.map((n) =>
            n === 'copy' ? (
              <button class="share-copy" type="button">
                <Glyph name="link" />
                <span>{t('copy_link')}</span>
              </button>
            ) : n === 'native' ? (
              <button class="share-native share-button" type="button">
                <Glyph name="share" />
                <span>{t('share')}</span>
              </button>
            ) : (
              <a href={networks[n]} target="_blank" rel="noopener noreferrer nofollow">
                <Glyph name={n} />
                <span>
                  {
                    (
                      { weibo: t('weibo'), twitter: 'X', telegram: 'Telegram', qq: 'QQ' } as Record<
                        string,
                        string
                      >
                    )[n]
                  }
                </span>
              </a>
            ),
          )}
        </div>
      )}
      {series && (
        <section class="article-series mica-card" aria-label={`${t('series')}: ${series.name}`}>
          <div class="series-heading">
            <h2>
              <span>{t('series')}</span>
              <strong>{series.name}</strong>
            </h2>
            <span class="series-progress">
              {t('series_progress')
                .replace('{current}', String(series.index + 1))
                .replace('{total}', String(series.items.length))}
            </span>
          </div>
          <ol class="series-list">
            {series.items.map((item) => (
              <li class:list={[{ current: item.path === post.path }]}>
                {item.path === post.path ? (
                  <span aria-current="page">{item.title}</span>
                ) : (
                  <a href={mountPath(item.path)}>{item.title}</a>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
      {theme.article.post_nav && (
        <nav class="post-navigation" aria-label={t('post_navigation')}>
          {previous && (
            <a href={mountPath(previous.path)}>
              <small>← {t('previous')}</small>
              <strong>{previous.title}</strong>
            </a>
          )}
          {next && (
            <a href={mountPath(next.path)}>
              <small>{t('next')} →</small>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )}
      {related.length > 0 && (
        <section class="related">
          <h2>{t('related')}</h2>
          {related.map(({ p }) => (
            <a href={mountPath(p.path)}>{p.title} ↗</a>
          ))}
        </section>
      )}
      <Comments post={post} />
    </article>
  </div>
</BaseLayout>
