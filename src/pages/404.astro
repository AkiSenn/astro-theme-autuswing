---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout path="/404.html" title="页面未找到" noindex>
  <article class="standalone-page">
    <div class="page-heading">
      <h1>404</h1>
    </div>
    <div class="not-found">
      <span>☀</span>
      <p>这页内容还没有到来，或已离开。</p>
      <a href="/" class="hero-link">
        返回首页 →
      </a>
    </div>
  </article>
</BaseLayout>
