---
import { theme, safeLink, preview } from '../site.config';
import { translate } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
const t = translate();
const f = theme.footer,
  counter = f.visit_counter;
// SSG 在构建时计算结束年，跨年后需重新构建；运行时统计另用 footer.runtime.since。
const currentYear = new Date().getFullYear();
const copyrightYears = theme.since === currentYear ? `${currentYear}` : `${theme.since}–${currentYear}`;
// 主题署名保留原 HTML 换行，避免配置化后编译器改成空格。
---

<footer class="site-footer">
  <div class="compact-social">
    <SocialLinks />
  </div>
  <div class="footer-row footer-credits">
    {f.copyright && (
      <span class="footer-copyright">
        © {copyrightYears} {theme.profile.author}
      </span>
    )}
    {f.powered_by && (
      <span class="footer-powered">
        Powered by{' '}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Astro
        </a>{' '}
        ·{' '}
        <a href={safeLink(f.theme_url)} target="_blank" rel="noopener noreferrer">{`\n${f.theme_name}\n`}</a>
      </span>
    )}
  </div>
  {(f.icp || f.police_icp) && (
    <div class="footer-row registration">
      {f.icp && (
        <a href={safeLink(f.icp_link)} target="_blank" rel="noopener noreferrer">
          {f.icp}
        </a>
      )}
      {f.police_icp && (
        <a href={safeLink(f.police_icp_link)} target="_blank" rel="noopener noreferrer">
          {f.police_icp_icon && <img src={f.police_icp_icon} width="18" height="18" alt="" />}
          {f.police_icp}
        </a>
      )}
    </div>
  )}
  {!preview && counter.enable && (
    <div class="footer-row footer-details">
      <div
        class="footer-stats"
        data-counter
        data-src={counter.src}
        data-allow-local={String(counter.allow_local)}
      >
        {(['today_pv', 'today_uv', 'site_pv', 'site_uv', 'page_pv', 'page_uv'] as const)
          .filter((k) => counter[k])
          .map((k) => (
            <span class="stat-counter">
              {t('statistics_' + k)}{' '}
              <strong id={(counter.provider === 'vercount' ? 'busuanzi_value_' : 'busuanzi_') + k}>
                —
              </strong>
            </span>
          ))}
        <span class="statistics-status" role="status"></span>
      </div>
    </div>
  )}
  {f.custom && <div class="footer-custom" set:html={f.custom} />}
</footer>
