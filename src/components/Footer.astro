---
import { mountReference } from '../lib/deployment.mjs';
import { site, theme, safeLink, preview } from '../site.config';
import { translate } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
const t = translate();
const f = theme.footer,
  counter = f.visit_counter;
// SSG 在构建时计算结束年，跨年后需重新构建。
const currentYear = new Date().getFullYear();
const { copyright, registrations, statement, extra, custom_html } = site.footer;
const copyrightYears = copyright.since && copyright.since !== currentYear
  ? copyright.since + '–' + currentYear
  : String(currentYear);
// 主题署名保留原 HTML 换行，避免配置化后编译器改成空格。
---

<footer class="site-footer">
  <div class="compact-social">
    <SocialLinks />
  </div>
  <div class="footer-row footer-credits">
    {f.copyright && (
      <span class="footer-copyright">
        © {copyrightYears} {copyright.holder}
      </span>
    )}
    {f.powered_by && (
      <span class="footer-powered">
        Powered by{' '}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Astro
        </a>{' '}
        ·{' '}
        <a href={mountReference(safeLink(f.theme_url))} target="_blank" rel="noopener noreferrer">{`\n${f.theme_name}\n`}</a>
      </span>
    )}
  </div>
  {registrations.length > 0 && (
    <div class="footer-row registration">
      {registrations.map((item) => {
        const Tag = item.url ? 'a' : 'span';
        return (
          <Tag href={item.url && mountReference(item.url)} target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined}>
            {item.icon && <img src={mountReference(item.icon)} width="18" height="18" alt="" />}
            {item.label}
          </Tag>
        );
      })}
    </div>
  )}
  {!preview && counter.enable && (
    <div class="footer-row footer-details">
      <div
        class="footer-stats"
        data-counter
        data-src={counter.src}
        data-allow-local={String(counter.allow_local)}
      >
        {(['today_pv', 'today_uv', 'site_pv', 'site_uv', 'page_pv', 'page_uv'] as const)
          .filter((k) => counter[k])
          .map((k) => (
            <span class="stat-counter">
              {t('statistics_' + k)}{' '}
              <strong id={(counter.provider === 'vercount' ? 'busuanzi_value_' : 'busuanzi_') + k}>
                —
              </strong>
            </span>
          ))}
        <span class="statistics-status" role="status"></span>
      </div>
    </div>
  )}
  {statement && <div class="footer-custom">{statement}</div>}
  {extra && <div class="footer-custom">{extra}</div>}
  {custom_html && <div class="footer-custom" set:html={custom_html} />}
</footer>
