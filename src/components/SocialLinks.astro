---
import { theme, safeLink } from '../site.config';
import Glyph from './Glyph.astro';
---

<div class="social-links">
  {theme.social_items.map((item) => (
    <a
      href={safeLink(item.url)}
      aria-label={item.name}
      title={item.name}
      tabindex="0"
      target={item.url.startsWith('http') ? '_blank' : undefined}
      rel="noopener noreferrer"
    >
      <Glyph name={item.icon} />
    </a>
  ))}
  {theme.feed.enable && (
    <a href="/rss.xml" title="RSS" aria-label="RSS" tabindex="0">
      <Glyph name="rss" />
    </a>
  )}
</div>
