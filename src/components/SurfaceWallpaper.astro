---
import { mountReference } from '../lib/deployment.mjs';
import { theme } from '../site.config';
interface Props {
  wallpaper?: string | boolean;
}
const wallpaper =
  Astro.props.wallpaper === false
    ? ''
    : typeof Astro.props.wallpaper === 'string'
      ? Astro.props.wallpaper
      : theme.cards.wallpaper;
---

{wallpaper && (
  <img
    class="surface-wallpaper"
    src={mountReference(wallpaper)}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
)}
