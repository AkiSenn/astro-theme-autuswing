---
import { translate } from '../lib/i18n';
const t = translate();
import Glyph from './Glyph.astro';
---

<dialog class="search-dialog" aria-labelledby="search-title">
  <div class="search-header">
    <h2 id="search-title">{t('search')}</h2>
    <button class="search-close icon-button" type="button" aria-label={t('close')}>
      ×
    </button>
  </div>
  <label class="search-field">
    <Glyph name="search" />
    <input
      type="search"
      id="search-input"
      placeholder={t('search_hint')}
      autocomplete="off"
      spellcheck="false"
      aria-label={t('search')}
    />
  </label>
  <p class="search-status" role="status" aria-live="polite">
    {t('search_hint')}
  </p>
  <ul class="search-results"></ul>
  <footer>
    ↑ ↓ {t('navigate')} · Enter {t('open')} · Esc {t('close')}
  </footer>
</dialog>
