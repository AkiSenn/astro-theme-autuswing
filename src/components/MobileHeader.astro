---
import { translate } from '../lib/i18n';
const t = translate();
import { theme, site } from '../site.config';
import AppearanceToggle from './AppearanceToggle.astro';
import Glyph from './Glyph.astro';
---

<header class="topbar">
  <a class="mobile-brand avatar-home" href="/">
    <img src={theme.avatar} alt="" width="32" height="32" />
    <span>{site.title}</span>
  </a>
  <div class="toolbar">
    {theme.search.enable && (
      <button
        class="search-open icon-button"
        type="button"
        aria-label={t('search')}
        aria-haspopup="dialog"
      >
        <Glyph name="search" />
      </button>
    )}
    {theme.appearance.theme_switch && <AppearanceToggle />}
    <button
      class="menu-toggle icon-button"
      type="button"
      aria-label={t('navigation')}
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <Glyph name="menu" />
    </button>
  </div>
</header>
